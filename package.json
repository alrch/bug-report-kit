{
  "name": "bug-report-kit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted visual bug reports for web projects",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-widget.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/widget.browser.mjs",
    "test:launcher": "npm run build && node --test tests/launcher.browser.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0"
  }
}
